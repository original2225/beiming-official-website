{
  "sampleName": "beiming-unified-backend-external-entrypoint-cutover",
  "sampleVersion": "1.0",
  "mode": "LOCAL_REHEARSAL_SAMPLE_NOT_APPLIED",
  "sampleConfigApplied": false,
  "applyProductionTraffic": false,
  "requiresUserApprovalBeforeApply": true,
  "businessPathRewriteAllowed": false,
  "currentEntrypoint": {
    "entrypointKey": "api-gateway",
    "baseUrl": "http://127.0.0.1:8125",
    "role": "CURRENT_GATEWAY_AND_ROLLBACK_ENTRYPOINT"
  },
  "candidateEntrypoint": {
    "entrypointKey": "unified-backend",
    "baseUrl": "http://127.0.0.1:8135",
    "role": "CANDIDATE_BACKEND_APPLICATION_ENTRYPOINT"
  },
  "rollbackEntrypoint": {
    "entrypointKey": "api-gateway",
    "baseUrl": "http://127.0.0.1:8125",
    "role": "PROTECTED_ROLLBACK_ENTRYPOINT"
  },
  "routePolicy": {
    "preserveApiV1BusinessPaths": true,
    "businessPathRewriteAllowed": false,
    "forbiddenBusinessPrefix": "/api/v1/unified-backend/<module>"
  },
  "trafficPolicy": {
    "productionTrafficAllowed": false,
    "localRehearsalOnly": true,
    "rollbackWindowRequired": true,
    "gatewayTrafficZeroProofRequired": true
  },
  "securityPolicy": {
    "credentialHeadersAllowed": false,
    "runtimeConfigValuesAllowed": false,
    "localAbsolutePathsAllowed": false,
    "runtimeCommandValuesAllowed": false,
    "sensitiveValuesExposed": false
  },
  "smokeTargets": [
